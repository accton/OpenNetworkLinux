#!/bin/sh
# This hook runs before the loader checks or mounts ONL filesystems.
# Keep early RAID logs available before switching rootfs.
mdraid_log=/etc/onl/mdraid.log
if python "/lib/platform-config/$(cat /etc/onl/platform)/onl/raid/onl-mdraid.py" loader >"$mdraid_log" 2>&1; then
    cat "$mdraid_log"
else
    # Block raw-member label lookup by later programs such as onl-pki.
    mkdir -p /run/onl && printf '{}\n' > /run/onl/block-devices.json
    {
        echo 'ONL mdraid: RAID setup failed.'
        cat "$mdraid_log"
    } > /etc/onl/abort
    cat /etc/onl/abort >&2
fi
