#!/bin/sh
# Run only as the restart action, after BusyBox init has cleaned up processes.
if [ "$$" -ne 1 ]; then
    echo 'ONL mdraid: switchroot must be executed by init as PID 1.' >&2
    exit 1
fi

while :; do
    if python "/lib/platform-config/$(cat /etc/onl/platform)/onl/raid/onl-mdraid.py" resume-root; then
        if [ -x /bin/switchroot.mdraid-original ]; then
            exec /bin/switchroot.mdraid-original
        fi
        echo 'ONL mdraid: native switchroot script is missing.' >&2
    fi
    echo 'ONL mdraid: rootfs handoff stopped. Exit this shell to retry.' >&2
    /bin/sh -i </dev/console >/dev/console 2>&1
done
